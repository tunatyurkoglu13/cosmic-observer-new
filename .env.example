NASA_API_KEY=your_nasa_api_key
SPACE_TRACK_USERNAME=your_username
SPACE_TRACK_PASSWORD=your_password

# Optional: Slack/Discord-compatible incoming webhook URL. If set, the active
# alert layer (core/alert_store.py + app.py's background scan loop) POSTs a
# {"text": ...} JSON payload to this URL for every new (non-deduplicated)
# alert, in addition to the in-app WebSocket push and browser notifications.
# Leave unset to disable outbound webhook delivery entirely (default).
ALERT_WEBHOOK_URL=
